{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taptop-toolkit.local/contracts/project/layout.schema.json",
  "title": "Taptop Toolkit project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "layoutVersion", "toolkitVersion", "namespace"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "layoutVersion": { "const": 2 },
    "toolkitVersion": { "type": "string", "minLength": 1 },
    "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "displayName": { "type": "string", "minLength": 1, "pattern": "\\S" }
  }
}
