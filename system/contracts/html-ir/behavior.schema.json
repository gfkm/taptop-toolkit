{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-taptop.local/contracts/html-ir/behavior.schema.json",
  "title": "Declared HTML behavior coverage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "behaviors"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "behaviors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "adapter", "nodeKeys"],
        "properties": {
          "key": { "$ref": "#/$defs/logicalKey" },
          "adapter": { "type": "string", "minLength": 1 },
          "nodeKeys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/logicalKey" } },
          "config": { "type": "object", "additionalProperties": true }
        }
      }
    }
  },
  "$defs": { "logicalKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" } }
}

